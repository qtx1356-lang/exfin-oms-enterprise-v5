# ==========================================
# SMART WORKFORCE — ENVIRONMENT CONFIGURATION
# ==========================================

# GEMINI_API_KEY: Required for Gemini AI API features (Smart Daily Brief, Receipt OCR, Attendance Intelligence).
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: The base URL where your Smart Workforce Web Application is hosted (e.g. https://your-domain.com).
# Used for self-referential links, email reports, and server endpoints.
APP_URL="https://your-domain.com"

# API Base URL for backend routes. Use this if the frontend and backend are hosted on separate domains.
VITE_API_BASE_URL=""

# COMPANY & GEOFENCE CONFIGURATION
VITE_COMPANY_NAME="Smart Workforce"
VITE_OFFICE_NAME="Main Office"
VITE_OFFICE_LATITUDE="0.000000"
VITE_OFFICE_LONGITUDE="0.000000"
VITE_OFFICE_RADIUS_METERS="25"

# FIREBASE CLIENT CONFIGURATION
# Create a Firebase Web App in your Firebase Console (https://console.firebase.google.com/)
# and paste your Web App credentials below:
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="YOUR_FIREBASE_PROJECT_ID.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="YOUR_FIREBASE_PROJECT_ID"
VITE_FIREBASE_STORAGE_BUCKET="YOUR_FIREBASE_PROJECT_ID.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_FIREBASE_MESSAGING_SENDER_ID"
VITE_FIREBASE_APP_ID="YOUR_FIREBASE_WEB_APP_ID"
VITE_FIREBASE_MEASUREMENT_ID=""

# FIREBASE SERVICE ACCOUNT FOR BACKEND (JSON STRING OR PATH)
# Required for Cloudflare Pages / Express backend tasks (Daily Email Reports & Push)
FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"YOUR_FIREBASE_PROJECT_ID",...}'

# OPTIONAL SERVER CONFIGURATION
PORT=3000
NODE_ENV="production"

# WHATSAPP CLOUD API CONFIGURATION (META FOR DEVELOPERS)
# Server-side only credentials for real-time auxiliary attendance WhatsApp dispatch.
# Never expose these with VITE_ prefix.
WHATSAPP_API_TOKEN="YOUR_META_WHATSAPP_SYSTEM_USER_ACCESS_TOKEN"
WHATSAPP_PHONE_NUMBER_ID="YOUR_WHATSAPP_PHONE_NUMBER_ID"
WHATSAPP_BUSINESS_ACCOUNT_ID="YOUR_WHATSAPP_BUSINESS_ACCOUNT_ID"
WHATSAPP_API_VERSION="v21.0"

# GMAIL / CUSTOM SMTP EMAIL CONFIGURATION FOR DAILY ADMIN REPORTS
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="your-admin-email@gmail.com"
SMTP_PASSWORD="your-16-character-app-password"
SMTP_PASS="your-16-character-app-password"
EMAIL_FROM_NAME="Smart Workforce Reports"
SMTP_FROM='"Smart Workforce Reports" <your-admin-email@gmail.com>'

# DAILY ADMIN EMAIL REPORT RECIPIENTS (COMMA-SEPARATED LIST)
EMAIL_RECIPIENTS="admin@yourcompany.com,hr@yourcompany.com,operations@yourcompany.com"

# SECURE SCHEDULER KEY
# Security token to authorize the automated daily scheduler invocation.
CRON_SECRET="your_strong_cron_secret_token_here"
