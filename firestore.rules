rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Admin checking functions
    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admin_users/$(request.auth.uid));
    }
    
    function getAdminRole() {
      return isAdmin() ? get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data.role : null;
    }
    
    function isSuperAdmin() {
      return getAdminRole() == 'SUPER_ADMIN';
    }

    function isHR() {
      return getAdminRole() == 'HR';
    }
    
    function isRegularAdmin() {
      return getAdminRole() == 'ADMIN';
    }

    match /metadata/counters {
      allow read: if true;
      allow write: if true; // Needs to be true for transaction to work during registration
    }

    match /departments/{departmentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /designations/{designationId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /roles/{roleId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /login_ids/{loginId} {
      allow get: if true;
      allow list, write: if isSuperAdmin();
    }

    match /admin_users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isSuperAdmin());
      allow write: if isSuperAdmin();
    }

    match /registrations/{registrationId} {
      allow create: if true;
      allow read: if true;
      allow update: if isAdmin() || 
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['profilePhotoUrl', 'selfieUrl'])) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasAll(['deviceId', 'selfieUrl']) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['profilePhotoUrl']));
      allow delete: if isSuperAdmin();
    }

    match /attendance/{attendanceId} {
      allow read, create, update: if true;
      allow delete: if isSuperAdmin();
    }

    match /live_locations/{employeeId} {
      allow read, create, update: if true;
      allow delete: if isSuperAdmin();
    }

    match /expenses/{expenseId} {
      allow read, create, update: if true;
      allow delete: if isSuperAdmin();
    }

    match /tasks/{taskId} {
      allow read, create, update: if true;
      allow delete: if isSuperAdmin();
    }

    match /system_settings/{settingsId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /notification_settings/{settingId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /daily_admin_reports/{reportId} {
      allow read: if isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    match /efficiency_snapshots/{snapshotId} {
      allow read, create: if true;
      allow update, delete: if isSuperAdmin();
    }
        
    match /notifications/{notificationId} {
      allow create: if true;
      allow read, update, delete: if isAdmin() || (
        request.auth != null && exists(/databases/$(database)/documents/registrations/$(request.auth.uid)) && (
          resource.data.recipientEmployeeCode == get(/databases/$(database)/documents/registrations/$(request.auth.uid)).data.employeeCode ||
          resource.data.recipientUserId == request.auth.uid ||
          (get(/databases/$(database)/documents/registrations/$(request.auth.uid)).data.isTeamLeader == true && (
            resource.data.recipientTeamLeaderId == get(/databases/$(database)/documents/registrations/$(request.auth.uid)).data.employeeCode ||
            resource.data.recipientTeamLeaderId == request.auth.uid
          ))
        )
      );
    }

    match /leave_config/{configId} {
      allow read: if true;
      allow write: if isSuperAdmin() || isHR();
    }

    match /employee_allowances/{allowanceId} {
      allow read: if true;
      allow write: if isSuperAdmin() || isHR();
    }

    match /leaves/{leaveId} {
      allow read, create, update: if true;
      allow delete: if isSuperAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isSuperAdmin() || isHR() || isRegularAdmin();
    }

    match /audit_logs/{logId} {
      allow create: if true;
      allow read: if isSuperAdmin();
      allow update, delete: if false;
    }

    match /salaries/{salaryId} {
      allow read: if isAdmin() || (request.auth != null && resource.data.employeeCode == get(/databases/$(database)/documents/registrations/$(request.auth.uid)).data.employeeCode);
      allow write: if isAdmin();
    }

    match /salary_employee_configs/{configId} {
      allow read, write: if isAdmin();
    }

    match /salary_leave_audits/{auditId} {
      allow read, write: if isAdmin();
    }

    // Helper to get chat identity (employeeCode or admin loginId)
    function getChatIdentity() {
      return exists(/databases/$(database)/documents/registrations/$(request.auth.uid))
        ? get(/databases/$(database)/documents/registrations/$(request.auth.uid)).data.employeeCode
        : (exists(/databases/$(database)/documents/admin_users/$(request.auth.uid))
           ? get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data.loginId
           : null);
    }

    match /chat_conversations/{conversationId} {
      allow read: if request.auth != null && (
        resource.data.type == 'ALL_EMPLOYEES' ||
        getChatIdentity() in resource.data.participantIds
      );
      allow create: if request.auth != null && (
        request.resource.data.type == 'ALL_EMPLOYEES' ||
        getChatIdentity() in request.resource.data.participantIds
      );
      allow update: if request.auth != null && (
        resource.data.type == 'ALL_EMPLOYEES' ||
        getChatIdentity() in resource.data.participantIds
      );
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if request.auth != null && (
          get(/databases/$(database)/documents/chat_conversations/$(conversationId)).data.type == 'ALL_EMPLOYEES' ||
          getChatIdentity() in get(/databases/$(database)/documents/chat_conversations/$(conversationId)).data.participantIds
        );
        allow create: if request.auth != null && (
          (get(/databases/$(database)/documents/chat_conversations/$(conversationId)).data.type == 'ALL_EMPLOYEES' ||
           getChatIdentity() in get(/databases/$(database)/documents/chat_conversations/$(conversationId)).data.participantIds) &&
          request.resource.data.senderId == getChatIdentity()
        );
        allow update, delete: if false; // Messages are immutable
      }
    }

    match /chat_attachments/{attachmentId} {
      allow read, create, update: if true;
      allow delete: if isAdmin();

      match /chunks/{chunkId} {
        allow read, create, update: if true;
        allow delete: if isAdmin();
      }
    }

    match /expense_receipt_attachments/{attachmentId} {
      allow read, create, update: if request.auth != null;
      allow delete: if isAdmin();

      match /chunks/{chunkId} {
        allow read, create, update: if request.auth != null;
        allow delete: if isAdmin();
      }
    }

    // Video calls are created and mutated only by the authenticated server (Firebase Admin SDK).
    // Clients can read only invitations addressed to them or sent by them, and calls they participate in.
    match /video_call_invites/{inviteId} {
      allow read: if request.auth != null &&
        (resource.data.recipientUid == request.auth.uid || resource.data.senderUid == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /video_calls/{callId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.participantUids;
      allow create, update, delete: if false;
    }

    // Device tokens are private server-side delivery addresses; never expose them to clients.
    match /push_device_tokens/{tokenId} {
      allow read, create, update, delete: if false;
    }

    match /push_web_subscriptions/{subscriptionId} {
      allow read, create, update, delete: if false;
    }


    // Replacement direct-call signaling. A participant can read only calls involving their UID.
    match /native_webrtc_calls/{callId} {
      allow create: if request.auth != null
        && exists(/databases/$(database)/documents/admin_users/$(request.auth.uid))
        && request.resource.data.callerUid == request.auth.uid
        && request.resource.data.recipientUid is string
        && request.resource.data.recipientUid != request.auth.uid
        && request.resource.data.status == 'ringing'
        && request.resource.data.callId == callId;
      allow get, list: if request.auth != null
        && (resource.data.callerUid == request.auth.uid || resource.data.recipientUid == request.auth.uid);
      allow update: if request.auth != null
        && (resource.data.callerUid == request.auth.uid || resource.data.recipientUid == request.auth.uid)
        && request.resource.data.callerUid == resource.data.callerUid
        && request.resource.data.recipientUid == resource.data.recipientUid
        && request.resource.data.callId == resource.data.callId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answer', 'status', 'acceptedAt', 'declinedAt', 'endedAt', 'expiresAt']);
      allow delete: if false;

      match /callerCandidates/{candidateId} {
        allow read: if request.auth != null
          && (get(/databases/$(database)/documents/native_webrtc_calls/$(callId)).data.callerUid == request.auth.uid
            || get(/databases/$(database)/documents/native_webrtc_calls/$(callId)).data.recipientUid == request.auth.uid);
        allow create: if request.auth != null
          && get(/databases/$(database)/documents/native_webrtc_calls/$(callId)).data.callerUid == request.auth.uid;
        allow update, delete: if false;
      }
      match /calleeCandidates/{candidateId} {
        allow read: if request.auth != null
          && (get(/databases/$(database)/documents/native_webrtc_calls/$(callId)).data.callerUid == request.auth.uid
            || get(/databases/$(database)/documents/native_webrtc_calls/$(callId)).data.recipientUid == request.auth.uid);
        allow create: if request.auth != null
          && get(/databases/$(database)/documents/native_webrtc_calls/$(callId)).data.recipientUid == request.auth.uid;
        allow update, delete: if false;
      }
    }


  }
}
