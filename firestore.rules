rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /metadata/counters {
      allow read, write: if true;
    }
    match /registrations/{registrationId} {
      allow read, write: if true;
    }
    match /attendance/{attendanceId} {
      allow read, write: if true;
    }
  }
}
