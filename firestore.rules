rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Admin checking functions
    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admin_users/$(request.auth.uid));
    }
    
    function getAdminRole() {
      return isAdmin() ? get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data.role : null;
    }
    
    function isSuperAdmin() {
      return getAdminRole() == 'SUPER_ADMIN';
    }

    function isHR() {
      return getAdminRole() == 'HR';
    }
    
    function isRegularAdmin() {
      return getAdminRole() == 'ADMIN';
    }

    // Since employees use Anonymous auth (their UID is the registration ID)
    function isEmployee() {
      return request.auth != null && 
             exists(/databases/$(database)/documents/registrations/$(request.auth.uid));
    }

    function getEmployeeCode() {
      return isEmployee() ? get(/databases/$(database)/documents/registrations/$(request.auth.uid)).data.employeeCode : null;
    }

    // Check if the current user is a Team Leader
    function isTeamLeader() {
      return isEmployee() && 
             get(/databases/$(database)/documents/registrations/$(request.auth.uid)).data.isTeamLeader == true;
    }
    
    function isOwner(resourceCode) {
      return isEmployee() && getEmployeeCode() == resourceCode;
    }

    function isTeamLeaderFor(teamLeaderCode) {
      return isTeamLeader() && getEmployeeCode() == teamLeaderCode;
    }

    function isTeamLeaderById(teamLeaderId) {
      return isTeamLeader() && request.auth.uid == teamLeaderId;
    }

    // Role-based Access Control configuration from the 'roles' collection
    function hasFeatureAccess(role, feature) {
      return exists(/databases/$(database)/documents/roles/$(role)) && 
             get(/databases/$(database)/documents/roles/$(role)).data.permissions[feature] == true;
    }

    match /metadata/counters {
      allow read: if true;
      allow write: if true; // Needs to be true for transaction to work during registration
    }
    
    match /roles/{roleId} {
      allow read: if request.auth != null;
      allow write: if isSuperAdmin();
    }

    match /admin_users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isSuperAdmin());
      allow write: if isSuperAdmin();
    }

    match /registrations/{registrationId} {
      allow create: if request.auth != null && request.auth.uid == registrationId;
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == registrationId);
      allow update: if isSuperAdmin() || isHR() || isRegularAdmin() || 
                    (request.auth != null && request.auth.uid == registrationId && 
                     request.resource.data.status == resource.data.status &&
                     request.resource.data.employeeCode == resource.data.employeeCode &&
                     request.resource.data.isTeamLeader == resource.data.isTeamLeader);
      allow delete: if isSuperAdmin();
    }

    function isValidTimestamp(ts) {
      // Allow slight clock skew for future timestamps (e.g. 5 minutes)
      // ts is usually an ISO string like '2023-10-10T10:00:00Z'.
      // In firestore rules, we can't easily parse ISO strings to timestamps unless they are actual Timestamp objects.
      // But they are probably strings in this app. Wait, if they are strings, we can't easily do math.
      // If they are Firestore Timestamps, we can do request.time.
      return true; // We'll restrict where possible.
    }

    match /attendance/{attendanceId} {
      allow read: if isAdmin() || isOwner(resource.data.employeeCode);
      allow create: if isOwner(request.resource.data.employeeCode);
      allow update: if isAdmin() || (isOwner(resource.data.employeeCode) && 
                                     request.resource.data.employeeCode == resource.data.employeeCode &&
                                     request.resource.data.checkInTime == resource.data.checkInTime &&
                                     request.resource.data.autoCheckIn == resource.data.autoCheckIn &&
                                     request.resource.data.manualCheckIn == resource.data.manualCheckIn &&
                                     request.resource.data.deviceEventTimestamp == resource.data.deviceEventTimestamp &&
                                     request.resource.data.checkInLatitude == resource.data.checkInLatitude &&
                                     request.resource.data.checkInLongitude == resource.data.checkInLongitude &&
                                     request.resource.data.attendanceMode == resource.data.attendanceMode &&
                                     request.resource.data.geofenceStatus == resource.data.geofenceStatus &&
                                     request.resource.data.distanceFromOffice == resource.data.distanceFromOffice &&
                                     (
                                       (!('checkOutTime' in resource.data) || resource.data.checkOutTime == null) ||
                                       request.resource.data.checkOutTime == resource.data.checkOutTime
                                     ));
      allow delete: if isSuperAdmin();
    }

    match /expenses/{expenseId} {
      allow read: if isAdmin() || isOwner(resource.data.employeeCode);
      allow create: if isOwner(request.resource.data.employeeCode);
      allow update: if isAdmin() || (isOwner(resource.data.employeeCode) && 
                                     resource.data.status == 'PENDING' &&
                                     request.resource.data.status == 'PENDING' &&
                                     request.resource.data.employeeCode == resource.data.employeeCode &&
                                     request.resource.data.approvedBy == resource.data.approvedBy &&
                                     request.resource.data.approvedAt == resource.data.approvedAt);
      allow delete: if isSuperAdmin();
    }

    match /tasks/{taskId} {
      allow read: if isAdmin() || 
                  (resource.data.assignedToEmployeeCodes != null && resource.data.assignedToEmployeeCodes.hasAny([getEmployeeCode()])) ||
                  isTeamLeaderFor(resource.data.teamLeaderCode) ||
                  isTeamLeaderById(resource.data.teamLeaderId);
      allow create: if isAdmin() || isTeamLeaderFor(request.resource.data.teamLeaderCode) || isTeamLeaderById(request.resource.data.teamLeaderId);
      allow update: if isAdmin() || 
                    isTeamLeaderFor(resource.data.teamLeaderCode) || 
                    isTeamLeaderById(resource.data.teamLeaderId) ||
                    (resource.data.assignedToEmployeeCodes != null && resource.data.assignedToEmployeeCodes.hasAny([getEmployeeCode()]) && 
                     request.resource.data.teamLeaderCode == resource.data.teamLeaderCode &&
                     request.resource.data.assignedToEmployeeCodes == resource.data.assignedToEmployeeCodes);
      allow delete: if isSuperAdmin() || isTeamLeaderFor(resource.data.teamLeaderCode) || isTeamLeaderById(resource.data.teamLeaderId);
    }

    match /system_settings/{settingsId} {
      allow read: if request.auth != null;
      allow write: if isSuperAdmin();
    }

    match /efficiency_snapshots/{snapshotId} {
      allow read: if isAdmin() || isOwner(resource.data.employeeCode) || isTeamLeaderById(resource.data.teamLeaderId);
      allow create: if isOwner(request.resource.data.employeeCode);
      allow update, delete: if isSuperAdmin();
    }
        
    match /notifications/{notificationId} {
      allow create: if request.auth != null && request.resource.data.id != null;
      allow read: if isAdmin() || 
                  (resource.data.recipientEmployeeCode == 'SYSTEM') || 
                  (resource.data.recipientRole == 'SYSTEM') || 
                  isOwner(resource.data.recipientEmployeeCode) ||
                  isTeamLeaderById(resource.data.recipientTeamLeaderId) ||
                  isTeamLeaderFor(resource.data.recipientTeamLeaderCode);
      allow update: if (isOwner(resource.data.recipientEmployeeCode) || isTeamLeaderById(resource.data.recipientTeamLeaderId)) && 
                    request.resource.data.recipientEmployeeCode == resource.data.recipientEmployeeCode &&
                    request.resource.data.recipientUserId == resource.data.recipientUserId &&
                    request.resource.data.recipientRole == resource.data.recipientRole &&
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'updatedAtDeviceTime', 'syncStatus', 'serverSyncTime']);
      allow delete: if isSuperAdmin();
    }

    match /leave_config/{configId} {
      allow read: if request.auth != null;
      allow write: if isSuperAdmin() || isHR();
    }

    match /employee_allowances/{allowanceId} {
      allow read: if isAdmin() || isOwner(resource.data.employeeCode);
      allow write: if isSuperAdmin() || isHR();
    }

    match /leaves/{leaveId} {
      allow read: if isAdmin() || isOwner(resource.data.employeeCode) || isTeamLeaderById(resource.data.teamLeaderId);
      allow create: if isOwner(request.resource.data.employeeCode);
      allow update: if isSuperAdmin() || isHR() || isRegularAdmin() || 
                    isTeamLeaderById(resource.data.teamLeaderId) ||
                    (isOwner(resource.data.employeeCode) && 
                     resource.data.status == 'PENDING' &&
                     request.resource.data.status == 'PENDING' &&
                     request.resource.data.employeeCode == resource.data.employeeCode &&
                     request.resource.data.currentApproverId == resource.data.currentApproverId);
      allow delete: if isSuperAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if request.auth != null;
      allow write: if isSuperAdmin() || isHR() || isRegularAdmin();
    }
    match /audit_logs/{logId} {
      // Employees can create audit logs (e.g. for their own actions) but only admins can read them
      allow create: if request.auth != null;
      allow read: if isAdmin();
      allow update, delete: if false; // Audit logs are immutable
    }
  }
}
