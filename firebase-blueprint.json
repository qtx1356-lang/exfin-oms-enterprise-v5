{
  "entities": {
    "Registration": {
      "title": "Registration",
      "description": "Employee device registration record",
      "type": "object",
      "properties": {
        "employeeCode": { "type": "string" },
        "name": { "type": "string" },
        "mobileNumber": { "type": "string" },
        "deviceId": { "type": "string" },
        "deviceModel": { "type": "string" },
        "androidVersion": { "type": "string" },
        "appVersion": { "type": "string" },
        "selfieUrl": { "type": "string" },
        "registrationDate": { "type": "string" },
        "status": { "type": "string" },
        "rejectionReason": { "type": "string" },
        "office": { "type": "string" }
      },
      "required": ["employeeCode", "name", "deviceId", "registrationDate", "status"]
    },
    "AttendanceRecord": {
      "title": "AttendanceRecord",
      "description": "Smart Attendance Record with offline support and sync tracking",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "employeeId": { "type": "string" },
        "employeeName": { "type": "string" },
        "date": { "type": "string" },
        "checkInTime": { "type": "string" },
        "checkOutTime": { "type": "string" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "distance": { "type": "number" },
        "townCity": { "type": "string" },
        "checkInMode": { "type": "string", "enum": ["AUTO", "MANUAL"] },
        "checkOutMode": { "type": "string", "enum": ["MANUAL", "AUTO_SYSTEM", "N/A"] },
        "reason": { "type": "string" },
        "createdAtDeviceTime": { "type": "string" },
        "syncStatus": { "type": "string", "enum": ["Pending", "Synced"] },
        "serverSyncTime": { "type": "string" },
        "isOffline": { "type": "boolean" },
        "reminderCount": { "type": "number" }
      },
      "required": ["id", "employeeId", "date", "checkInTime", "checkInMode", "createdAtDeviceTime"]
    },
    "SystemSettings": {
      "title": "SystemSettings",
      "description": "Configurable system-wide settings including efficiency score weights",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "efficiencyTaskCompletionWeight": { "type": "number" },
        "efficiencyOnTimeWeight": { "type": "number" },
        "efficiencyQualityWeight": { "type": "number" },
        "efficiencyPunctualityWeight": { "type": "number" },
        "efficiencyWorkloadWeight": { "type": "number" },
        "updatedAt": { "type": "string" },
        "updatedBy": { "type": "string" },
        "updatedByName": { "type": "string" }
      },
      "required": ["id", "efficiencyTaskCompletionWeight", "efficiencyOnTimeWeight", "efficiencyQualityWeight", "efficiencyPunctualityWeight", "efficiencyWorkloadWeight"]
    },
    "EfficiencySnapshot": {
      "title": "EfficiencySnapshot",
      "description": "Saved period-based efficiency metrics snapshot for historical reporting",
      "type": "object",
      "properties": {
        "employeeId": { "type": "string" },
        "employeeCode": { "type": "string" },
        "employeeName": { "type": "string" },
        "department": { "type": "string" },
        "teamLeaderId": { "type": "string" },
        "periodStart": { "type": "string" },
        "periodEnd": { "type": "string" },
        "periodType": { "type": "string" },
        "taskCompletionScore": { "type": "number" },
        "onTimeCompletionScore": { "type": "number" },
        "qualityScore": { "type": "number" },
        "punctualityScore": { "type": "number" },
        "workloadScore": { "type": "number" },
        "overduePenalty": { "type": "number" },
        "revisionPenalty": { "type": "number" },
        "finalScore": { "type": "number" },
        "grade": { "type": "string" },
        "calculatedAtDeviceTime": { "type": "string" },
        "serverSyncTime": { "type": "string" }
      },
      "required": ["employeeId", "employeeCode", "employeeName", "periodStart", "periodEnd", "periodType", "finalScore", "grade", "calculatedAtDeviceTime"]
    },
    "NotificationRecord": {
      "title": "NotificationRecord",
      "description": "Secure, centralized, offline-first notification record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "category": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "recipientUserId": { "type": "string" },
        "recipientEmployeeCode": { "type": "string" },
        "recipientRole": { "type": "string" },
        "recipientTeamLeaderId": { "type": "string" },
        "priority": { "type": "string" },
        "route": { "type": "string" },
        "entityId": { "type": "string" },
        "entityType": { "type": "string" },
        "read": { "type": "boolean" },
        "timestamp": { "type": "string" },
        "createdAtDeviceTime": { "type": "string" },
        "updatedAtDeviceTime": { "type": "string" },
        "serverSyncTime": { "type": "string" },
        "syncStatus": { "type": "string" }
      },
      "required": ["id", "type", "category", "title", "message", "recipientEmployeeCode", "recipientRole", "read", "timestamp"]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Administrative user metadata with associated loginId",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "loginId": { "type": "string" },
        "role": { "type": "string" },
        "active": { "type": "boolean" },
        "email": { "type": "string" },
        "authorizedOffice": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "loginId", "role"]
    },
    "LoginId": {
      "title": "LoginId",
      "description": "Globally unique login ID reference matching a known email address",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "uid": { "type": "string" }
      },
      "required": ["email", "uid"]
    }
  },
  "firestore": {
    "/registrations/{registrationId}": {
      "schema": "Registration",
      "description": "Device registrations for employee approval"
    },
    "/attendance/{attendanceId}": {
      "schema": "AttendanceRecord",
      "description": "Smart attendance logs and sync data"
    },
    "/system_settings/{settingsId}": {
      "schema": "SystemSettings",
      "description": "System configuration parameters"
    },
    "/efficiency_snapshots/{snapshotId}": {
      "schema": "EfficiencySnapshot",
      "description": "Historical employee efficiency ratings"
    },
    "/notifications/{notificationId}": {
      "schema": "NotificationRecord",
      "description": "Central notification collection"
    },
    "/admin_users/{userId}": {
      "schema": "AdminUser",
      "description": "Administrative user mapping collection"
    },
    "/login_ids/{loginId}": {
      "schema": "LoginId",
      "description": "Mapping from unique login ID to Firebase Auth identity details"
    }
  }
}
